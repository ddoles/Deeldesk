# ============================================================================
# Deeldesk.ai - Environment Variables Template
# ============================================================================
# Copy this file to .env and fill in your values
# Never commit .env to version control!
# ============================================================================

# ----------------------------------------------------------------------------
# DATABASE (Required)
# ----------------------------------------------------------------------------
# PostgreSQL with pgvector extension
# For Neon: Use pooled connection string
DATABASE_URL=postgresql://user:password@host/database?sslmode=require
DIRECT_URL=postgresql://user:password@host/database?sslmode=require

# ----------------------------------------------------------------------------
# REDIS (Required for BullMQ job queue)
# ----------------------------------------------------------------------------
# Railway provides this automatically via ${{Redis.REDIS_URL}}
REDIS_URL=redis://localhost:6379

# ----------------------------------------------------------------------------
# AI SERVICES (Required)
# ----------------------------------------------------------------------------

# Anthropic Claude API
# Get your key at: https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-xxx

# OpenAI API (for embeddings)
# Get your key at: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-proj-xxx

# Default models
DEFAULT_LLM_MODEL=claude-sonnet-4-20250514
DEFAULT_EMBEDDING_MODEL=text-embedding-3-small

# ----------------------------------------------------------------------------
# AWS BEDROCK (Optional - for enterprise data sovereignty)
# ----------------------------------------------------------------------------
AWS_REGION=us-west-2
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
BEDROCK_CLAUDE_MODEL_ID=anthropic.claude-3-5-sonnet-20241022-v2:0

# ----------------------------------------------------------------------------
# AUTHENTICATION (Required)
# ----------------------------------------------------------------------------
# Full URL of your deployment (no trailing slash)
NEXTAUTH_URL=http://localhost:3000

# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=

# Google OAuth (Optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ----------------------------------------------------------------------------
# APPLICATION SETTINGS
# ----------------------------------------------------------------------------
NODE_ENV=development
LOG_LEVEL=debug

# ----------------------------------------------------------------------------
# FILE STORAGE (Optional - for local development with MinIO)
# ----------------------------------------------------------------------------
S3_BUCKET=deeldesk-dev
S3_REGION=us-east-1
S3_ENDPOINT=http://localhost:9000
S3_FORCE_PATH_STYLE=true
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
